---
/**
 * Política de privacidad (RGPD y LOPDGDD). Los datos del responsable salen de src/config/site.ts.
 * TODO asesoría: revisar el texto.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import LegalData from '@/components/LegalData.astro';
import { site } from '@/config/site';

const email = site.contact.email.endsWith('@example.com') ? '' : site.contact.email;
---

<BaseLayout
  title="Política de privacidad"
  description="Cómo tratamos los datos personales que nos envías a través de los formularios de la web o por email, conforme al RGPD y la LOPDGDD."
  noindex
  breadcrumbs={[{ name: 'Política de privacidad', href: '/privacidad/' }]}
>
  <PageHeader title="Política de privacidad" />
  <article class="container prose section">
    <h2>Responsable del tratamiento</h2>
    <LegalData />

    <h2>Qué datos tratamos y para qué</h2>
    <p>
      Los datos que nos envías por los formularios de la web (pedir tarifa, reservar una demo, pedir
      envases y descargar la checklist) o por email: nombre, empresa, email, teléfono, los datos de
      tu solicitud y tu mensaje. Los usamos para responderte y, si nos lo pides, prepararte una
      oferta o enviarte lo que has solicitado. También guardamos la página desde la que nos
      escribes, para saber qué contenidos son útiles.
    </p>

    <h2>Base legal</h2>
    <p>
      Tu consentimiento al enviar la solicitud y, en su caso, la aplicación de medidas
      precontractuales a petición tuya.
    </p>

    <h2>Quién trata los datos por nosotros</h2>
    <p>
      La web está alojada en Cloudflare, que recibe los formularios y nos los envía como encargado
      del tratamiento. Los envíos se guardan en una base de datos con ubicación en la Unión Europea.
      El correo electrónico lo gestiona Zoho, con servidores en la Unión Europea.
    </p>

    <h2>Conservación</h2>
    <p>Mientras dure la relación y, después, durante los plazos que exija la ley.</p>

    <h2>Tus derechos</h2>
    <p>
      Puedes ejercer los derechos de acceso, rectificación, supresión, oposición, limitación y
      portabilidad escribiendo a{' '}
      {email ? <a href={`mailto:${email}`}>{email}</a> : <em>pendiente</em>}. También puedes
      reclamar ante la Agencia Española de Protección de Datos (
      <a href="https://www.aepd.es" rel="noopener" target="_blank">
        aepd.es
      </a>
      ).
    </p>
  </article>
</BaseLayout>
