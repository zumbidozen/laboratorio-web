---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Icon from '@/components/Icon.astro';
import Faq from '@/components/Faq.astro';
import HeroVisual from '@/components/HeroVisual.astro';
import { site, primaryCta } from '@/config/site';
import {
  getServicios,
  getSectores,
  getGuias,
  getFaq,
  getPlanes,
  servicioUrl,
  sectorUrl,
  guiaUrl,
} from '@/lib/content';
import { faqPage } from '@/lib/schema';
import { highlights, steps, stats, comparison } from '@/data/home';

const servicios = (await getServicios()).filter((s) => s.data.category === 'analisis');
const sectores = await getSectores();
const guias = (await getGuias()).slice(0, 3);
const faq = (await getFaq()).slice(0, 5).map((e) => e.data);
const planes = (await getPlanes()).slice(0, 3);
const soon = (s: (typeof servicios)[number]) =>
  s.data.status === 'proximamente'
    ? `Próximamente${s.data.availableFrom ? ` · ${s.data.availableFrom}` : ''}`
    : undefined;
---

<BaseLayout title={site.homeTitle} description={site.description} path="/" schema={[faqPage(faq)]}>
  <!-- Portada -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__kicker">
          <span>Laboratorio de aguas</span>
          <span class="hero__line" aria-hidden="true"></span>
          <span>{site.contact.address.region}</span>
        </p>
        <h1>
          Análisis de agua, <em>sin papeles</em> ni esperas.
        </h1>
        <p class="lead">
          Legionella, agua de consumo, piscinas y torres para empresas de mantenimiento. Pides
          online o por API, sigues cada muestra en tiempo real y entregas el informe con tu
          logotipo.
        </p>
        <div class="hero__actions">
          <a class="btn" href={primaryCta.href}>
            {primaryCta.label} <Icon name="arrow-right" />
          </a>
          <a class="btn btn--ghost" href="/como-trabajamos/">
            Cómo trabajamos
          </a>
        </div>
      </div>
      <HeroVisual />
    </div>
    <div class="container">
      <dl class="hero__stats">
        {stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Tres ventajas -->
  <section class="highlights" aria-label="Ventajas">
    <div class="container highlights__grid">
      {highlights.map((h) => (
        <article class="highlight reveal">
          <span class="icon-tile">
            <Icon name={h.icon} />
          </span>
          <div>
            <h2>{h.title}</h2>
            <p>{h.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Análisis -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">01 — Análisis</p>
        <h2>Los análisis obligatorios, con la norma al día</h2>
        <p class="lead">
          Cultivo y físico-químico en nuestro laboratorio. La química avanzada (metales, PFAS,
          trihalometanos) la realiza un laboratorio colaborador acreditado y llega en el mismo
          informe.
        </p>
      </div>
      <div class="grid">
        {servicios.map((s) => (
          <Card
            href={servicioUrl(s)}
            title={s.data.name}
            text={s.data.summary}
            icon={s.data.icon}
            badge={soon(s)}
            meta={s.data.regulations.slice(0, 3).join(' · ')}
          />
        ))}
      </div>
      <p class="more">
        <a class="link-arrow" href="/servicios/">
          Todos los análisis y servicios <Icon name="arrow-right" />
        </a>
      </p>
    </div>
  </section>

  <!-- Comparativa -->
  <section class="section">
    <div class="container compare">
      <div class="section-head">
        <p class="eyebrow">02 — Para empresas de servicios</p>
        <h2>Lo que cambia en tu día a día</h2>
        <p class="lead">
          Pensado para quien toma las muestras en hoteles, residencias, comunidades e industria y
          revende el análisis.
        </p>
        <a class="link-arrow" href="/partners/">
          Ver el Programa Partner <Icon name="arrow-right" />
        </a>
      </div>
      <div class="compare__table reveal" role="table" aria-label="Antes y con nosotros">
        <div class="compare__row compare__row--head" role="row">
          <span role="columnheader">Hoy</span>
          <span role="columnheader">Con nosotros</span>
        </div>
        {comparison.map((c) => (
          <div class="compare__row" role="row">
            <span role="cell" class="compare__before">
              <Icon name="x" />
              {c.before}
            </span>
            <span role="cell" class="compare__after">
              <Icon name="check" />
              {c.after}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">03 — Cómo funciona</p>
        <h2>De la toma al informe, sin una sola llamada</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="reveal">
            <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="icon-tile">
              <Icon name={s.icon} />
            </span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="more">
        <a class="link-arrow" href="/como-trabajamos/">
          Plazos, portal e informes <Icon name="arrow-right" />
        </a>
      </p>
    </div>
  </section>

  <!-- Planes -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">04 — Planes</p>
        <h2>Una cuota fija y te olvidas del calendario</h2>
        <p class="lead">
          Paquetes por instalación o por centro que incluyen los análisis que exige la norma, el
          registro digital y las alertas.
        </p>
      </div>
      <div class="grid">
        {planes.map((p) => (
          <Card
            href={`/planes/#${p.id}`}
            title={p.data.name}
            text={p.data.audience}
            icon={p.data.icon}
            meta={p.data.billing}
            cta="Ver el plan"
          />
        ))}
      </div>
      <p class="more">
        <a class="link-arrow" href="/planes/">
          Todos los planes <Icon name="arrow-right" />
        </a>
      </p>
    </div>
  </section>

  <!-- Sectores -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">05 — Para quién</p>
        <h2>Trabajamos con quien mantiene las instalaciones</h2>
      </div>
      <div class="grid">
        {sectores.map((s) => (
          <Card href={sectorUrl(s)} title={s.data.name} text={s.data.summary} icon={s.data.icon} />
        ))}
      </div>
    </div>
  </section>

  <!-- Guías -->
  {guias.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">06 — Guías</p>
          <h2>La normativa, explicada en corto</h2>
        </div>
        <div class="grid">
          {guias.map((g) => (
            <Card
              href={guiaUrl(g)}
              title={g.data.title}
              text={g.data.description}
              icon="file"
              cta="Leer la guía"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Preguntas -->
  <section class="section section--alt">
    <div class="container">
      <Faq items={faq} title="Lo que más nos preguntan" split>
        <p class="muted">¿Tienes otra duda? Mira todas las preguntas o escríbenos.</p>
        <a class="link-arrow" href="/preguntas-frecuentes/">
          Todas las preguntas <Icon name="arrow-right" />
        </a>
      </Faq>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  /* Portada */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 5vw, 4rem) 0;
    background:
      radial-gradient(60rem 36rem at 85% 10%, var(--color-accent-soft), transparent 65%),
      linear-gradient(180deg, var(--color-brand-tint), var(--color-bg) 85%);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-5);
    }
  }
  .hero__copy > * + * {
    margin-top: var(--space-4);
  }
  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .hero__line {
    width: 3.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }
  @media (max-width: 640px) {
    .hero__kicker {
      letter-spacing: 0.18em;
      font-size: 0.7rem;
    }
    .hero__line,
    .hero__kicker span:last-child {
      display: none;
    }
  }
  .hero h1 {
    font-size: clamp(2.8rem, 6.6vw, 5.4rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 12ch;
  }
  .hero h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-accent-strong);
  }
  .hero .lead {
    max-width: 34rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .hero__stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .hero__stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.3rem;
    padding: var(--space-4) var(--space-3) var(--space-4) 0;
  }
  @media (min-width: 900px) {
    .hero__stats > div + div {
      padding-left: var(--space-4);
      border-left: 1px solid var(--color-border);
    }
  }
  .hero__stats dd {
    font-weight: 300;
    font-size: clamp(1.9rem, 3.2vw, 2.4rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .hero__stats dt {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    max-width: 15rem;
  }

  /* Tres ventajas */
  .highlights {
    padding-block: var(--space-5) var(--space-3);
  }
  .highlights__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .highlight {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    box-shadow: var(--shadow);
  }
  .highlight h2 {
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0;
  }
  .highlight p {
    margin-top: 0.3rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .more {
    margin-top: var(--space-5);
  }

  /* Comparativa */
  .compare {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 1000px) {
    .compare {
      grid-template-columns: 1fr 1.25fr;
    }
    .compare .section-head {
      position: sticky;
      top: 7rem;
    }
  }
  .compare__table {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .compare__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .compare__row > span {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding: 1rem 1.2rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.95rem;
  }
  .compare__row--head > span {
    border-top: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .compare__row > span:first-child {
    color: var(--color-text-muted);
    background: var(--color-surface);
  }
  .compare__row > span:last-child {
    font-weight: 500;
    background: var(--color-brand-tint);
  }
  .compare__row :global(svg) {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.15em;
  }
  .compare__before :global(svg) {
    color: var(--color-alert);
  }
  .compare__after :global(svg) {
    color: var(--color-ok);
  }

  /* Proceso */
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    counter-reset: step;
  }
  .steps li {
    position: relative;
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-border);
  }
  .steps li::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 3rem;
    height: 2px;
    background: var(--color-brand);
  }
  .steps__num {
    position: absolute;
    top: var(--space-4);
    right: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-border);
  }
  .steps h3 {
    margin-top: var(--space-3);
  }
  .steps p {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }
</style>
