---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Icon from '@/components/Icon.astro';
import Faq from '@/components/Faq.astro';
import PortalMock from '@/components/PortalMock.astro';
import { site, primaryCta } from '@/config/site';
import {
  getServicios,
  getSectores,
  getGuias,
  getFaq,
  getPlanes,
  servicioUrl,
  sectorUrl,
  guiaUrl,
} from '@/lib/content';
import { faqPage } from '@/lib/schema';
import { promises, steps, stats, comparison } from '@/data/home';

const servicios = (await getServicios()).filter((s) => s.data.category === 'analisis');
const sectores = await getSectores();
const guias = (await getGuias()).slice(0, 3);
const faq = (await getFaq()).slice(0, 5).map((e) => e.data);
const planes = (await getPlanes()).slice(0, 3);
const soon = (s: (typeof servicios)[number]) =>
  s.data.status === 'proximamente'
    ? `Próximamente${s.data.availableFrom ? ` · ${s.data.availableFrom}` : ''}`
    : undefined;
---

<BaseLayout title={site.homeTitle} description={site.description} path="/" schema={[faqPage(faq)]}>
  <!-- Portada -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">
          <span class="dot" aria-hidden="true"></span>
          Laboratorio de aguas · {site.contact.address.region}
        </p>
        <h1>{site.tagline}</h1>
        <p class="lead">
          Analizamos Legionella, agua de consumo, piscinas y torres para empresas de mantenimiento y
          control de Legionella. Pides online o por API, sigues cada muestra en tiempo real y
          entregas el informe con tu logotipo.
        </p>
        <div class="hero__actions">
          <a class="btn" href={primaryCta.href}>
            {primaryCta.label} <Icon name="arrow-right" />
          </a>
          <a class="btn btn--ghost" href="/servicios/">
            Ver análisis
          </a>
        </div>
        <ul class="hero__norms" aria-label="Normativa que cubrimos">
          <li>RD 487/2022</li>
          <li>RD 3/2023</li>
          <li>RD 742/2013</li>
          <li>Decreto 99/2024</li>
          <li>ISO 11731</li>
        </ul>
      </div>
      <PortalMock />
    </div>
  </section>

  <!-- Cifras -->
  <section class="stats" aria-label="Compromisos">
    <div class="container">
      <dl class="stats__grid">
        {stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Análisis -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Análisis</p>
        <h2>Los análisis obligatorios, con la norma al día</h2>
        <p class="lead">
          Cultivo y físico-químico en nuestro laboratorio. La química avanzada (metales, PFAS,
          trihalometanos) la realiza un laboratorio colaborador acreditado y llega en el mismo
          informe.
        </p>
      </div>
      <div class="grid">
        {servicios.map((s) => (
          <Card
            href={servicioUrl(s)}
            title={s.data.name}
            text={s.data.summary}
            icon={s.data.icon}
            badge={soon(s)}
            meta={s.data.regulations.slice(0, 3).join(' · ')}
          />
        ))}
      </div>
      <p class="more">
        <a class="link-arrow" href="/servicios/">
          Todos los análisis y servicios <Icon name="arrow-right" />
        </a>
      </p>
    </div>
  </section>

  <!-- Ventajas -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Por qué trabajar con nosotros</p>
        <h2>El análisis lo marca la norma. Todo lo demás, lo hacemos mejor</h2>
      </div>
      <ul class="features">
        {promises.map((p) => (
          <li class="reveal">
            <span class="icon-tile">
              <Icon name={p.icon} />
            </span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Comparativa -->
  <section class="section">
    <div class="container compare">
      <div class="section-head">
        <p class="eyebrow">Para empresas de servicios</p>
        <h2>Lo que cambia en tu día a día</h2>
        <p class="lead">
          Pensado para quien toma las muestras en hoteles, residencias, comunidades e industria y
          revende el análisis.
        </p>
        <a class="link-arrow" href="/sectores/empresas-de-servicios/">
          Ver cómo trabajamos con mantenedores <Icon name="arrow-right" />
        </a>
      </div>
      <div class="compare__table reveal" role="table" aria-label="Antes y con nosotros">
        <div class="compare__row compare__row--head" role="row">
          <span role="columnheader">Hoy</span>
          <span role="columnheader">Con nosotros</span>
        </div>
        {comparison.map((c) => (
          <div class="compare__row" role="row">
            <span role="cell" class="compare__before">
              <Icon name="x" />
              {c.before}
            </span>
            <span role="cell" class="compare__after">
              <Icon name="check" />
              {c.after}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Cómo funciona</p>
        <h2>De la toma al informe, sin una sola llamada</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="reveal">
            <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="icon-tile">
              <Icon name={s.icon} />
            </span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="more">
        <a class="link-arrow" href="/como-trabajamos/">
          Plazos, portal e informes <Icon name="arrow-right" />
        </a>
      </p>
    </div>
  </section>

  <!-- Planes -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Planes</p>
        <h2>Una cuota fija y te olvidas del calendario</h2>
        <p class="lead">
          Paquetes por instalación o por centro que incluyen los análisis que exige la norma, el
          registro digital y las alertas.
        </p>
      </div>
      <div class="grid">
        {planes.map((p) => (
          <Card
            href={`/planes/#${p.id}`}
            title={p.data.name}
            text={p.data.audience}
            icon={p.data.icon}
            meta={p.data.billing}
            cta="Ver el plan"
          />
        ))}
      </div>
      <p class="more">
        <a class="link-arrow" href="/planes/">
          Todos los planes <Icon name="arrow-right" />
        </a>
      </p>
    </div>
  </section>

  <!-- Sectores -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Para quién</p>
        <h2>Trabajamos con quien mantiene las instalaciones</h2>
      </div>
      <div class="grid">
        {sectores.map((s) => (
          <Card href={sectorUrl(s)} title={s.data.name} text={s.data.summary} icon={s.data.icon} />
        ))}
      </div>
    </div>
  </section>

  <!-- Guías -->
  {guias.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Guías</p>
          <h2>La normativa, explicada en corto</h2>
        </div>
        <div class="grid">
          {guias.map((g) => (
            <Card
              href={guiaUrl(g)}
              title={g.data.title}
              text={g.data.description}
              icon="file"
              cta="Leer la guía"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Preguntas -->
  <section class="section section--alt">
    <div class="container">
      <Faq items={faq} title="Lo que más nos preguntan" split>
        <p class="muted">¿Tienes otra duda? Mira todas las preguntas o escríbenos.</p>
        <a class="link-arrow" href="/preguntas-frecuentes/">
          Todas las preguntas <Icon name="arrow-right" />
        </a>
      </Faq>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  /* Portada */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 6vw, 5rem);
    background:
      radial-gradient(48rem 28rem at 92% 0%, var(--color-brand-soft), transparent 70%),
      radial-gradient(
        36rem 24rem at 0% 100%,
        color-mix(in srgb, var(--color-accent) 12%, transparent),
        transparent 70%
      );
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      color-mix(in srgb, var(--color-brand) 18%, transparent) 1px,
      transparent 1px
    );
    background-size: 22px 22px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero__grid {
      grid-template-columns: 1.05fr 1fr;
      gap: var(--space-6);
    }
  }
  .hero__copy > * + * {
    margin-top: var(--space-4);
  }
  .hero h1 {
    max-width: 16ch;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 25%, transparent);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hero__norms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    padding: var(--space-3) 0 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  /* Cifras */
  .stats {
    border-block: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 900px) {
    .stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stats__grid > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: var(--space-4) var(--space-2);
  }
  @media (min-width: 900px) {
    .stats__grid > div + div {
      border-left: 1px solid var(--color-border);
      padding-left: var(--space-4);
    }
  }
  .stats dd {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 3.6vw, 2.6rem);
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-text);
  }
  .stats dt {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    max-width: 16rem;
  }

  .more {
    margin-top: var(--space-5);
  }

  /* Ventajas */
  .features {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .features li {
    padding: 1.6rem;
    border-radius: var(--radius);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }
  .features h3 {
    margin-top: var(--space-3);
  }
  .features p {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  /* Comparativa */
  .compare {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 1000px) {
    .compare {
      grid-template-columns: 1fr 1.25fr;
    }
    .compare .section-head {
      position: sticky;
      top: 7rem;
    }
  }
  .compare__table {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .compare__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .compare__row > span {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding: 1rem 1.2rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.95rem;
  }
  .compare__row--head > span {
    border-top: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .compare__row > span:first-child {
    color: var(--color-text-muted);
    background: var(--color-surface);
  }
  .compare__row > span:last-child {
    font-weight: 500;
    background: var(--color-brand-tint);
  }
  .compare__row :global(svg) {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.15em;
  }
  .compare__before :global(svg) {
    color: var(--color-alert);
  }
  .compare__after :global(svg) {
    color: var(--color-ok);
  }

  /* Proceso */
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    counter-reset: step;
  }
  .steps li {
    position: relative;
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-border);
  }
  .steps li::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 3rem;
    height: 2px;
    background: var(--color-brand);
  }
  .steps__num {
    position: absolute;
    top: var(--space-4);
    right: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-border);
  }
  .steps h3 {
    margin-top: var(--space-3);
  }
  .steps p {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }
</style>
