---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Icon from '@/components/Icon.astro';

const steps = [
  {
    icon: 'qr',
    title: 'Crea el pedido',
    text: 'En el portal o por API. Cada muestra recibe un código y su etiqueta QR, ya asociada a la instalación y al punto de muestreo.',
  },
  {
    icon: 'test-tube',
    title: 'Usa el envase correcto',
    text: 'Te enviamos los envases estériles adecuados a cada análisis. Si el agua lleva cloro u otro biocida oxidante, el envase incluye tiosulfato para neutralizarlo.',
  },
  {
    icon: 'clipboard',
    title: 'Anota los datos de la toma',
    text: 'Fecha y hora, punto exacto, temperatura del agua y biocida residual medidos in situ. Sin estos datos el resultado pierde valor ante una inspección.',
  },
  {
    icon: 'truck',
    title: 'Envía refrigerado y rápido',
    text: 'En nevera con acumuladores de frío, protegida de la luz y lo antes posible tras la toma. El plazo máximo de entrega figura en el pedido.',
  },
] as const;

const rejects = [
  'Envase sin etiqueta o con un código que no coincide con el pedido.',
  'Muestra que llega fuera de plazo o sin refrigerar.',
  'Envase roto, abierto o con volumen insuficiente.',
  'Muestra de agua clorada en un envase sin neutralizante.',
];
---

<BaseLayout
  title="Cómo tomar y enviar una muestra de agua"
  description="Guía para enviar muestras de agua a Ensayum: pedido con etiqueta QR, envase correcto, datos de la toma, transporte refrigerado y causas de rechazo."
  breadcrumbs={[{ name: 'Enviar muestras', href: '/enviar-muestras/' }]}
>
  <PageHeader
    eyebrow="Enviar muestras"
    icon="truck"
    title="Cómo enviar una muestra sin que te la rechacen"
    summary="Cuatro pasos: pedido con etiqueta QR, envase adecuado, datos de la toma anotados y transporte refrigerado lo antes posible."
  >
    <p class="actions">
      <a class="btn" href="/descargas/cadena-de-custodia-ensayum.pdf" download>
        Cadena de custodia en PDF <Icon name="arrow-right" />
      </a>
      <a class="btn btn--ghost" href="/cadena-de-custodia/">
        Ver el formulario
      </a>
    </p>
  </PageHeader>

  <section class="section">
    <div class="container">
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="reveal">
            <span class="steps__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="icon-tile">
              <Icon name={s.icon} />
            </span>
            <h2>{s.title}</h2>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container split">
      <div class="section-head">
        <p class="eyebrow">Evita repetir la toma</p>
        <h2>Por qué se rechaza una muestra</h2>
        <p class="lead">
          Si una muestra no se puede analizar te avisamos en cuanto la recibimos, para que puedas
          repetir la toma.
        </p>
      </div>
      <ul class="rejects">
        {rejects.map((r) => (
          <li>
            <Icon name="x" />
            <span>{r}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container note">
      <Icon name="shield" />
      <p>
        Cada tipo de instalación tiene su procedimiento de toma (puntos, volumen, purga, en caliente
        o en frío). Te lo damos por escrito con el alta como partner, junto con los envases.
      </p>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .steps li {
    position: relative;
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-border);
  }
  .steps li::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 3rem;
    height: 2px;
    background: var(--color-accent);
  }
  .steps__num {
    position: absolute;
    top: var(--space-4);
    right: 0;
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-text-subtle);
  }
  .steps h2 {
    margin-top: var(--space-3);
    font-size: 1.25rem;
    font-weight: 500;
  }
  .steps p {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }
  .split {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 1000px) {
    .split {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-6);
    }
  }
  .rejects {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .rejects li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem 1.2rem;
    border-radius: var(--radius);
    background: var(--color-bg);
    box-shadow: var(--shadow-sm);
  }
  .rejects :global(svg) {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.2em;
    color: var(--color-alert);
  }
  .note {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    max-width: 52rem;
  }
  .note > :global(svg) {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-accent-strong);
  }
  .note p {
    color: var(--color-text-muted);
  }
</style>
