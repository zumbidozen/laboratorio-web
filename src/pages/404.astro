---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PetriDish from '@/components/PetriDish.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o ha cambiado de dirección. Vuelve al inicio o revisa nuestros análisis de agua."
  noindex
>
  <PageHeader
    eyebrow="Error 404"
    title="Esta página no existe"
    summary="Puede que haya cambiado de dirección. Prueba desde el inicio o mira nuestros análisis."
  >
    <p class="actions">
      <a class="btn" href="/">
        Ir al inicio <Icon name="arrow-right" />
      </a>
      <a class="btn btn--ghost" href="/servicios/">
        Ver análisis
      </a>
    </p>
  </PageHeader>
  <section class="section">
    <div class="container lost">
      <PetriDish size={220} colonies={28} />
      <p class="muted">En esta placa sí ha crecido algo. La página que buscabas, no.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .lost {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    text-align: center;
  }
</style>
