---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Faq from '@/components/Faq.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { getServicios, servicioUrl, formatDate, isoDate } from '@/lib/content';
import { service, faqPage } from '@/lib/schema';

export const getStaticPaths = (async () => {
  const servicios = await getServicios();
  return servicios.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const href = servicioUrl(entry);
---

<BaseLayout
  title={data.title}
  description={data.description}
  updated={data.updated}
  breadcrumbs={[
    { name: 'Servicios', href: '/servicios/' },
    { name: data.name, href },
  ]}
  schema={[
    service({
      name: data.name,
      description: data.description,
      href,
      regulations: data.regulations,
      audience: data.audience,
    }),
    faqPage(data.faq),
  ]}
>
  <PageHeader eyebrow="Servicios" title={data.title} summary={data.summary}>
    {data.status === 'proximamente' && (
      <p>
        <span class="chip chip--soon">
          Próximamente{data.availableFrom ? ` · disponible en ${data.availableFrom}` : ''}
        </span>
      </p>
    )}
    {data.regulations.length > 0 && (
      <ul class="chips" aria-label="Normativa">
        {data.regulations.map((r) => (
          <li class="chip">{r}</li>
        ))}
      </ul>
    )}
  </PageHeader>

  <div class="container layout">
    <article class="prose">
      {data.includes.length > 0 && (
        <>
          <h2>Qué incluye</h2>
          <ul>
            {data.includes.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </>
      )}
      <Content />
      <p class="muted">
        Actualizado el <time datetime={isoDate(data.updated)}>{formatDate(data.updated)}</time>.
      </p>
    </article>
    <aside class="aside stack">
      {data.audience && (
        <p>
          <strong>Para quién:</strong> {data.audience}
        </p>
      )}
      <a class="btn" href="/contacto/">
        Pedir tarifa
      </a>
    </aside>
  </div>

  <div class="container section">
    <Faq items={data.faq} />
  </div>
  <CtaBanner />
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
    .aside {
      position: sticky;
      top: 6rem;
      align-self: start;
    }
  }
  .aside {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
</style>
