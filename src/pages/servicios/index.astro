---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Card from '@/components/Card.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { getServicios, servicioUrl } from '@/lib/content';

const all = await getServicios();
const groups = [
  {
    title: 'Análisis',
    text: 'Cultivo y físico-químico en nuestro laboratorio; química avanzada con laboratorio colaborador acreditado.',
    items: all.filter((s) => s.data.category === 'analisis'),
  },
  {
    title: 'Servicios',
    text: 'Lo que rodea al análisis: planes de prevención, formación y toma de muestras.',
    items: all.filter((s) => s.data.category === 'servicio'),
  },
];
const badge = (s: (typeof all)[number]) =>
  s.data.status === 'proximamente'
    ? `Próximamente${s.data.availableFrom ? ` · ${s.data.availableFrom}` : ''}`
    : undefined;
---

<BaseLayout
  title="Análisis de agua y servicios"
  description="Análisis de Legionella, agua de consumo, piscinas, torres y otros, más planes de prevención, formación y toma de muestras en la Comunidad de Madrid."
  breadcrumbs={[{ name: 'Servicios', href: '/servicios/' }]}
>
  <PageHeader
    eyebrow="Servicios"
    icon="flask"
    title="Análisis de agua y servicios"
    summary="Cubrimos los análisis obligatorios de Legionella, agua de consumo, piscinas y torres, y los servicios que los rodean."
  />
  {groups.map((g, i) => (
    <section class:list={['section', { 'section--alt': i % 2 === 1 }]}>
      <div class="container">
        <div class="section-head">
          <h2>{g.title}</h2>
          <p class="lead">{g.text}</p>
        </div>
        <div class="grid">
          {g.items.map((s) => (
            <Card
              href={servicioUrl(s)}
              title={s.data.name}
              text={s.data.summary}
              icon={s.data.icon}
              badge={badge(s)}
              meta={s.data.regulations.slice(0, 3).join(' · ')}
            />
          ))}
        </div>
      </div>
    </section>
  ))}
  <CtaBanner />
</BaseLayout>
