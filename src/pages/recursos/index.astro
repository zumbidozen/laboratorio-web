---
/** Índice de recursos descargables: los PDF con formulario y los documentos de trabajo libres. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import LeadMagnet from '@/components/LeadMagnet.astro';
import Card from '@/components/Card.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { recursos, descargasLibres } from '@/data/recursos';
---

<BaseLayout
  hideStickyCta
  title="Recursos descargables: checklists y plantillas"
  description="Checklists y plantillas en PDF para cumplir la normativa de Legionella y de piscinas: registro de mantenimiento, carpeta de inspección y calendarios."
  breadcrumbs={[{ name: 'Recursos', href: '/recursos/' }]}
>
  <PageHeader
    eyebrow="Recursos"
    icon="clipboard"
    title="Recursos descargables"
    summary="Checklists y plantillas en PDF para llevar al día los controles que pide la normativa de Legionella y de piscinas. Gratis, para imprimir y usar en cada instalación."
  />
  <section class="section">
    <div class="container">
      <ul class="index" data-pagefind-ignore>
        {recursos.map((r) => (
          <li>
            <a href={`#${r.id}`}>{r.short}</a>
          </li>
        ))}
      </ul>
      <div class="stack list">
        {recursos.map((r) => (
          <div id={r.id} class="anchor">
            <LeadMagnet recurso={r.id} origin="recursos" />
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Sin formulario</p>
        <h2>Documentos de trabajo</h2>
      </div>
      <div class="grid">
        {descargasLibres.map((d) => (
          <Card href={d.href} title={d.title} text={d.text} icon={d.icon} cta="Ver y descargar" />
        ))}
      </div>
    </div>
  </section>
  <CtaBanner />
</BaseLayout>

<style>
  .index {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .index a {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .index a:hover {
    border-color: var(--color-accent-strong);
  }
  .list > * + * {
    margin-top: var(--space-5);
  }
  .anchor {
    scroll-margin-top: 6rem;
  }
</style>
