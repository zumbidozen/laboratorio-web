---
/** Página de cada recurso descargable (formulario a cambio del PDF). */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import LeadMagnet from '@/components/LeadMagnet.astro';
import Icon from '@/components/Icon.astro';
import { recursos } from '@/data/recursos';

export const getStaticPaths = (() =>
  recursos.map((recurso) => ({
    params: { id: recurso.id },
    props: { recurso },
  }))) satisfies GetStaticPaths;

const { recurso } = Astro.props;
---

<BaseLayout
  hideStickyCta
  title={`${recurso.short} (PDF gratis)`}
  description={recurso.description}
  breadcrumbs={[
    { name: 'Recursos', href: '/recursos/' },
    { name: recurso.short, href: recurso.landing },
  ]}
>
  <PageHeader
    eyebrow="Recurso gratuito"
    icon={recurso.icon}
    title={recurso.title}
    summary={recurso.summary}
  />
  <section class="section">
    <div class="container stack">
      <LeadMagnet recurso={recurso.id} origin="landing" large />
      <p class="note">
        <Icon name="shield" />
        <span>
          Usamos tu email solo para enviarte este recurso y responderte si nos escribes. Más
          información en la <a href="/privacidad/">política de privacidad</a>.
        </span>
      </p>
      <p>
        <a href="/recursos/">Ver todos los recursos descargables</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .note {
    display: flex;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .note :global(svg) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-accent-strong);
  }
</style>
