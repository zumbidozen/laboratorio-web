---
/** Página de gracias de cada recurso: enlace al PDF. No se indexa. */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import { recursos } from '@/data/recursos';

export const getStaticPaths = (() =>
  recursos.map((recurso) => ({
    params: { id: recurso.id },
    props: { recurso },
  }))) satisfies GetStaticPaths;

const { recurso } = Astro.props;
---

<BaseLayout
  hideStickyCta
  title="Tu descarga está lista"
  description={`Descarga en PDF: ${recurso.short}. Gracias por tu interés en nuestro laboratorio de análisis de aguas en Madrid.`}
  noindex
>
  <PageHeader
    eyebrow="Descarga"
    icon="circle-check"
    title="Tu descarga está lista"
    summary={`Gracias. Aquí tienes el PDF: ${recurso.short}. Si quieres que lo repasemos contigo, escríbenos.`}
  >
    <p class="actions">
      <a class="btn" href={recurso.pdf} download>
        Descargar el PDF <Icon name="arrow-right" />
      </a>
      <a class="btn btn--ghost" href={recurso.next.href}>
        {recurso.next.label}
      </a>
      <a class="btn btn--ghost" href="/recursos/">
        Más recursos
      </a>
    </p>
  </PageHeader>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
