---
/**
 * Carpeta de inspección de Legionella: lista de documentos (fuente del PDF).
 * Contenido: guía «Registro de Legionella: qué anotar y cuánto guardarlo».
 */
import DocLayout from '@/layouts/DocLayout.astro';
import { carpetaInspeccion as recurso } from '@/data/recursos';

/** [documento, referencia] por bloque de la carpeta. */
const bloques: { titulo: string; docs: [string, string][] }[] = [
  {
    titulo: '1. El plan',
    docs: [
      [
        'Diagnóstico inicial y descripción de la instalación: datos técnicos, de funcionamiento, diseño y ubicación',
        'Art. 8.2.a',
      ],
      [
        'Plano o esquema de cada instalación con el circuito hidráulico, actualizado con cada modificación y su fecha',
        'Art. 8.2.a',
      ],
      [
        'Puntos de toma de muestra y de posible emisión de aerosoles, señalados en el plano',
        'Art. 8.2.a',
      ],
      ['Programa de mantenimiento y revisión', 'Art. 8.2.b'],
      ['Programa de tratamiento, con la limpieza y desinfección', 'Art. 8.2.b'],
      ['Programa de muestreo y análisis', 'Art. 8.2.b'],
      ['Programa de formación del personal', 'Art. 8.2.b'],
    ],
  },
  {
    titulo: '2. Los controles del día a día',
    docs: [
      [
        'Registro de cada control con su resultado: temperaturas, desinfectante, pH, purgas, revisión de depósitos y de puntos terminales',
        'Anexos IV y V',
      ],
      ['Incidencias y medidas adoptadas en cada control', 'Art. 8.2.c'],
      [
        'Componentes deteriorados: fecha en que se detectó, fecha de reparación o sustitución y quién la hizo',
        'Anexo IV',
      ],
      ['Fechas de paradas y puestas en marcha técnicas, con su motivo', 'Art. 8.2.c'],
      [
        'Declaración responsable del responsable técnico, del titular o de su representante legal',
        'Art. 8.2.c',
      ],
    ],
  },
  {
    titulo: '3. Los análisis',
    docs: [
      ['Registro de cada toma de muestras con todos sus datos', 'Anexo VI, parte G'],
      [
        'Informes del laboratorio, con el cultivo de Legionella por método acreditado según UNE-EN ISO/IEC 17025',
        'Art. 12.1',
      ],
      ['Los informes indican la incertidumbre y el límite de detección', 'Anexo VII, parte C'],
      [
        'Trazabilidad de cada muestra: lo planificado, el transporte, el documento de toma, el resultado y las medidas correctoras',
