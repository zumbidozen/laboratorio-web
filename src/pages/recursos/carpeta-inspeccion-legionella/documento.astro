  {
    titulo: '6. Los productos y equipos',
    docs: [
      [
        'Biocidas autorizados y registrados o notificados, con nombre comercial y número de registro',
        'Art. 16.1',
      ],
      [
        'Fichas de datos técnicos y de seguridad de los demás productos de limpieza y tratamiento',
        'Anexo X',
