      [
        'Torres y condensadores evaporativos: notificación de puesta en funcionamiento en un mes (y de la baja)',
        'Art. 5.3 y anexo II',
      ],
      [
        'Instalaciones nuevas o remodeladas: declaración responsable de los requisitos de diseño',
        'Art. 6.1 y anexo III',
      ],
      [
        'Edificios prioritarios: resultados de Legionella del agua sanitaria notificados en SINAC',
        'Art. 11.7',
      ],
    ],
