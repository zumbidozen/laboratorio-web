---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PortalMock from '@/components/PortalMock.astro';
import Icon from '@/components/Icon.astro';
import NetlifyForm from '@/components/NetlifyForm.astro';

const agenda = [
  'Cómo se crea un pedido y se imprimen las etiquetas QR',
  'El estado de cada muestra y los avisos fuera de límite',
  'El informe con tu logotipo y la factura mensual',
  'La API, si quieres conectar tu software',
];
---

<BaseLayout
  title="Reserva una demo del portal"
  description="Reserva una demo de 20 minutos del portal de Ensayum: pedidos con etiqueta QR, estado de cada muestra, avisos, informes con tu marca y API."
  breadcrumbs={[{ name: 'Demo', href: '/demo/' }]}
>
  <PageHeader
    eyebrow="Demo"
    icon="activity"
    title="Te enseñamos el portal en 20 minutos"
    summary="Por videollamada. Elige cuándo te viene bien y te enviamos la invitación."
  />

  <section class="section">
    <div class="container layout">
      <div class="stack">
        <h2>Qué verás</h2>
        <ul class="checklist">
          {agenda.map((a) => (
            <li>
              <Icon name="check" />
              <span>{a}</span>
            </li>
          ))}
        </ul>
        <PortalMock />
      </div>

      <div class="panel">
        <NetlifyForm name="demo" submit="Pedir la demo" mailSubject="Demo del portal">
          <label class="field">
            <span>Nombre y apellidos</span>
            <input name="nombre" autocomplete="name" required />
          </label>
          <label class="field">
            <span>Empresa</span>
            <input name="empresa" autocomplete="organization" required />
          </label>
          <label class="field">
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label class="field">
            <span>
              Teléfono <small>(opcional)</small>
            </span>
            <input name="telefono" type="tel" autocomplete="tel" />
          </label>
          <label class="field">
            <span>¿Cuándo te viene bien?</span>
            <select name="franja">
              <option>Mañanas (9:00–14:00)</option>
              <option>Tardes (15:00–18:00)</option>
              <option>Me da igual</option>
            </select>
          </label>
        </NetlifyForm>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-6);
    }
    .panel {
      position: sticky;
      top: 6.5rem;
    }
  }
  h2 {
    font-size: 1.5rem;
  }
</style>
