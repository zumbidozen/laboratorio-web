---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PortalMock from '@/components/PortalMock.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';

const isNetlify = site.contact.form === 'netlify';
const action = isNetlify ? '/contacto/gracias/' : site.contact.form;
const agenda = [
  'Cómo se crea un pedido y se imprimen las etiquetas QR',
  'El estado de cada muestra y los avisos fuera de límite',
  'El informe con tu logotipo y la factura mensual',
  'La API, si quieres conectar tu software',
];
---

<BaseLayout
  title="Reserva una demo del portal"
  description="Reserva una demo de 20 minutos del portal de Ensayum: pedidos con etiqueta QR, estado de cada muestra, avisos, informes con tu marca y API."
  breadcrumbs={[{ name: 'Demo', href: '/demo/' }]}
>
  <PageHeader
    eyebrow="Demo"
    icon="activity"
    title="Te enseñamos el portal en 20 minutos"
    summary="Por videollamada. Elige cuándo te viene bien y te enviamos la invitación."
  />

  <section class="section">
    <div class="container layout">
      <div class="stack">
        <h2>Qué verás</h2>
        <ul class="checklist">
          {agenda.map((a) => (
            <li>
              <Icon name="check" />
              <span>{a}</span>
            </li>
          ))}
        </ul>
        <PortalMock />
      </div>

      <div class="panel">
        {site.contact.form ? (
          <form
            class="form"
            name="demo"
            method="POST"
            action={action}
            data-netlify={isNetlify ? 'true' : undefined}
            netlify-honeypot={isNetlify ? 'empresa-web' : undefined}
          >
            {isNetlify && <input type="hidden" name="form-name" value="demo" />}
            <p class="visually-hidden">
              <label>
                No rellenes este campo:{' '}
                <input name="empresa-web" tabindex="-1" autocomplete="off" />
              </label>
            </p>
            <label>
              <span>Nombre y apellidos</span>
              <input name="nombre" autocomplete="name" required />
            </label>
            <label>
              <span>Empresa</span>
              <input name="empresa" autocomplete="organization" required />
            </label>
            <label>
              <span>Email</span>
              <input name="email" type="email" autocomplete="email" required />
            </label>
            <label>
              <span>
                Teléfono <small>(opcional)</small>
              </span>
              <input name="telefono" type="tel" autocomplete="tel" />
            </label>
            <label>
              <span>¿Cuándo te viene bien?</span>
              <select name="franja">
                <option>Mañanas (9:00–14:00)</option>
                <option>Tardes (15:00–18:00)</option>
                <option>Me da igual</option>
              </select>
            </label>
            <label class="check">
              <input type="checkbox" name="privacidad" required />
              <span>
                He leído y acepto la <a href="/privacidad/">política de privacidad</a>.
              </span>
            </label>
            <button class="btn" type="submit">
              Pedir la demo <Icon name="arrow-right" />
            </button>
          </form>
        ) : (
          <p>
            Escríbenos a{' '}
            <a href={`mailto:${site.contact.email}?subject=Demo del portal`}>
              {site.contact.email}
            </a>
            .
          </p>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-6);
    }
    .panel {
      position: sticky;
      top: 6.5rem;
    }
  }
  h2 {
    font-size: 1.5rem;
  }
  .panel {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    box-shadow: var(--shadow-lg);
  }
  .form {
    display: grid;
    gap: 1rem;
  }
  .form label:not(.check) {
    display: grid;
    gap: 0.35rem;
  }
  .form label > span {
    font-weight: 500;
    font-size: 0.92rem;
  }
  small {
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .form input:not([type='checkbox']),
  .form select {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .form input:focus,
  .form select:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
  }
  .check {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.92rem;
  }
  .check input {
    margin-top: 0.3em;
    accent-color: var(--color-brand);
  }
  .form .btn {
    justify-self: start;
  }
</style>
