---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import NetlifyForm from '@/components/NetlifyForm.astro';
import { site, addressLine } from '@/config/site';

const { contact } = site;
const analyses = ['Legionella', 'Agua de consumo', 'Piscinas', 'Torres y calderas', 'Otros'];
const next = [
  'Te escribimos para conocer tu volumen, tu laboratorio actual y cuándo vence tu contrato.',
  'Te enviamos una tarifa profesional con descuento por volumen.',
  'Si quieres, hacemos una prueba de dos meses con muestras duplicadas para que compares plazos y resultados.',
];
---

<BaseLayout
  title="Contacto y tarifa profesional"
  description="Pide tarifa profesional para tus análisis de agua: cuéntanos cuántas muestras mueves al mes y qué tipo de instalaciones mantienes."
  breadcrumbs={[{ name: 'Contacto', href: '/contacto/' }]}
>
  <PageHeader
    eyebrow="Contacto"
    icon="mail"
    title="Pide tarifa profesional"
    summary="Cuéntanos qué analizas y cuántas muestras mueves al mes, y te preparamos una tarifa con descuento por volumen."
  />

  <section class="section">
    <div class="container layout">
      <div class="panel">
        <NetlifyForm name="contacto" mailSubject="Tarifa profesional">
          <div class="form__row">
            <label class="field">
              <span>Nombre y apellidos</span>
              <input name="nombre" autocomplete="name" required />
            </label>
            <label class="field">
              <span>Empresa</span>
              <input name="empresa" autocomplete="organization" required />
            </label>
          </div>
          <div class="form__row">
            <label class="field">
              <span>Email</span>
              <input name="email" type="email" autocomplete="email" required />
            </label>
            <label class="field">
              <span>
                Teléfono <small>(opcional)</small>
              </span>
              <input name="telefono" type="tel" autocomplete="tel" />
            </label>
          </div>
          <fieldset>
            <legend>¿Qué analizas?</legend>
            <div class="pills">
              {analyses.map((o) => (
                <label class="pill">
                  <input type="checkbox" name="analisis" value={o} />
                  <span>{o}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <div class="form__row">
            <label class="field">
              <span>Muestras al mes (aprox.)</span>
              <select name="volumen" id="volumen">
                <option>Menos de 50</option>
                <option>50–100</option>
                <option>100–300</option>
                <option>Más de 300</option>
              </select>
            </label>
            <label class="field">
              <span>
                Laboratorio actual <small>(opcional)</small>
              </span>
              <input name="laboratorio_actual" />
            </label>
          </div>
          <label class="field">
            <span>
              Cuéntanos algo más <small>(opcional)</small>
            </span>
            <textarea name="mensaje" id="mensaje" rows="5"></textarea>
          </label>
        </NetlifyForm>
      </div>

      <aside class="stack">
        <h2>Qué pasa después</h2>
        <ol class="next">
          {next.map((n, i) => (
            <li>
              <span>{i + 1}</span>
              <p>{n}</p>
            </li>
          ))}
        </ol>
        <ul class="direct">
          {contact.email && (
            <li>
              <Icon name="mail" />
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </li>
          )}
          {contact.phone && (
            <li>
              <Icon name="phone" />
              <a href={`tel:${contact.phone}`}>{contact.phoneDisplay || contact.phone}</a>
            </li>
          )}
          <li>
            <Icon name="map-pin" />
            <span>{addressLine()}</span>
          </li>
          {contact.hours && (
            <li>
              <Icon name="clock" />
              <span>{contact.hours}</span>
            </li>
          )}
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  // Si se llega desde la calculadora, se rellena el mensaje con el resumen.
  try {
    const resumen = sessionStorage.getItem('ensayum-calculo');
    const mensaje = document.getElementById('mensaje') as HTMLTextAreaElement | null;
    if (resumen && mensaje && new URLSearchParams(location.search).has('calculo')) {
      mensaje.value = resumen;
    }
  } catch {
    /* sin almacenamiento: no pasa nada */
  }
</script>

<style>
  .layout {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
  aside h2 {
    font-size: 1.4rem;
  }
  .next {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .next li {
    display: flex;
    gap: 0.85rem;
  }
  .next span {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font-weight: 500;
    font-size: 0.9rem;
  }
  .next p {
    color: var(--color-text-muted);
  }
  .direct {
    list-style: none;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: 0.6rem;
  }
  .direct li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .direct :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-accent-strong);
  }
</style>
