---
/**
 * Plantilla base de TODAS las páginas: <head> con SEO, cabecera, pie,
 * migas de pan y enlace "saltar al contenido".
 */
import '@/styles/global.css';
import { site, primaryCta } from '@/config/site';
import Icon from '@/components/Icon.astro';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { breadcrumbs as breadcrumbsSchema } from '@/lib/schema';

type SeoProps = import('@/components/Seo.astro').Props;

export interface Props extends SeoProps {
  /** Migas de pan sin incluir "Inicio" (se añade solo). Vacío = no se muestran. */
  breadcrumbs?: { name: string; href: string }[];
  /** Oculta el botón fijo «Pedir tarifa» del móvil (páginas con formulario propio). */
  hideStickyCta?: boolean;
}

const { breadcrumbs = [], schema = [], hideStickyCta = false, ...seo } = Astro.props;
const crumbs = breadcrumbs.length ? [{ name: 'Inicio', href: '/' }, ...breadcrumbs] : [];
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B3C5D" />
    <meta name="generator" content={Astro.generator} />
    {site.analytics.plausibleDomain && (
      <script
        defer
        data-domain={site.analytics.plausibleDomain}
        src="https://plausible.io/js/script.js"
      />
    )}
    <Seo {...seo} schema={[...schema, crumbs.length ? breadcrumbsSchema(crumbs) : null]} />
  </head>
  <body>
    <a class="skip" href="#contenido">
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
      <slot />
    </main>
    <Footer />
    {!hideStickyCta && (
      <a class="sticky-cta" href={primaryCta.href} data-sticky-cta>
        {primaryCta.label} <Icon name="arrow-right" />
      </a>
    )}
    {site.contact.whatsapp && (
      <a
        class="whatsapp"
        href={`https://wa.me/${site.contact.whatsapp}`}
        target="_blank"
        rel="noopener"
        aria-label="Escríbenos por WhatsApp"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" width="26" height="26">
          <path
            fill="currentColor"
            d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.6-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3 1 2.5c.1.2 1.6 2.5 4 3.5 1.5.6 2 .7 2.8.6.4-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z"
          ></path>
        </svg>
      </a>
    )}
    <script>
      // Efectos globales, sin librerías. Se desactivan si el visitante pide menos movimiento.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Foco de luz en tarjetas (.spotlight): el halo sigue al ratón.
      if (!reduce && window.matchMedia('(hover: hover)').matches) {
        document.addEventListener(
          'pointermove',
          (e) => {
            const card = (e.target as HTMLElement | null)?.closest?.<HTMLElement>('.spotlight');
            if (!card) return;
            const r = card.getBoundingClientRect();
            card.style.setProperty('--spot-x', `${e.clientX - r.left}px`);
            card.style.setProperty('--spot-y', `${e.clientY - r.top}px`);
          },
          { passive: true },
        );
      }

      // Botón fijo «Pedir tarifa» en móvil: aparece al bajar y se oculta al llegar al pie.
      const cta = document.querySelector<HTMLElement>('[data-sticky-cta]');
      const footer = document.querySelector('footer');
      if (cta) {
        let nearFooter = false;
        const update = () => cta.toggleAttribute('data-show', window.scrollY > 480 && !nearFooter);
        if (footer) {
          new IntersectionObserver(([entry]) => {
            nearFooter = entry.isIntersecting;
            update();
          }).observe(footer);
        }
        window.addEventListener('scroll', update, { passive: true });
        update();
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    z-index: 100;
    background: var(--color-bg);
    padding: 0.5rem 1rem;
  }
  .skip:focus {
    left: 0.5rem;
  }
  .whatsapp {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: var(--shadow-lg);
  }
  .sticky-cta {
    position: fixed;
    left: max(1rem, env(safe-area-inset-left, 0px));
    right: max(1rem, env(safe-area-inset-right, 0px));
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 55;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.2rem;
    border-radius: 999px;
    background: var(--color-petrol);
    color: #fff;
    font-weight: 500;
    text-decoration: none;
    box-shadow: var(--shadow-lg);
    transform: translateY(calc(100% + 2rem));
    transition: transform 0.35s var(--ease);
  }
  /* Si hay botón de WhatsApp, deja su hueco a la derecha. */
  .whatsapp ~ .sticky-cta,
  .sticky-cta:has(~ .whatsapp) {
    right: 5.4rem;
  }
  .sticky-cta :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }
  .sticky-cta[data-show] {
    transform: none;
  }
  .sticky-cta:hover {
    color: #fff;
  }
  @media (min-width: 960px) {
    .sticky-cta {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-cta {
      transition: none;
    }
  }
  .whatsapp:hover {
    color: #fff;
    transform: translateY(-2px);
  }
</style>
