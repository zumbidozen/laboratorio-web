---
/**
 * Formulario común de la web (contacto, demo, envases…).
 * Gestiona Netlify Forms, el campo trampa anti-spam, la casilla de privacidad,
 * el botón de envío y la alternativa por email si no hay formulario configurado.
 * Los campos van en el slot, con las clases globales de `global.css` (.form, .field, .pill…).
 */
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';

export interface Props {
  /** Nombre del formulario en Netlify (aparece así en el panel Forms). */
  name: string;
  /** Texto del botón. */
  submit?: string;
  /** Asunto del email si no hay formulario. */
  mailSubject?: string;
  /** Página a la que se va tras enviar (solo con Netlify Forms). */
  success?: string;
  /** Oculta la casilla de privacidad y la pone como texto (formularios cortos). */
  compact?: boolean;
}

const {
  name,
  submit = 'Enviar',
  mailSubject = 'Contacto desde la web',
  success = '/contacto/gracias/',
  compact = false,
} = Astro.props;
const { form, email } = site.contact;
const isNetlify = form === 'netlify';
const action = isNetlify ? success : form;
---

{form ? (
  <form
    class:list={['form', { 'form--compact': compact }]}
    name={name}
    method="POST"
    action={action}
    data-netlify={isNetlify ? 'true' : undefined}
    netlify-honeypot={isNetlify ? 'empresa-web' : undefined}
  >
    {isNetlify && <input type="hidden" name="form-name" value={name} />}
    {/* Página donde se rellena y página de la que se venía: para saber qué páginas traen contactos. */}
    <input type="hidden" name="pagina" data-form-meta="pagina" />
    <input type="hidden" name="llegada" data-form-meta="llegada" />
    <p class="visually-hidden">
      <label>
        No rellenes este campo: <input name="empresa-web" tabindex="-1" autocomplete="off" />
      </label>
    </p>
    <slot />
    <label class="check">
      <input type="checkbox" name="privacidad" required />
      <span>
        He leído y acepto la <a href="/privacidad/">política de privacidad</a>.
      </span>
    </label>
    <button class="btn" type="submit">
      {submit} <Icon name="arrow-right" />
    </button>
  </form>
) : (
  <p>
    Escríbenos a <a href={`mailto:${email}?subject=${encodeURIComponent(mailSubject)}`}>{email}</a>.
  </p>
)}

<script>
  // Rellena los campos ocultos de origen de todos los formularios de la página.
  const here = location.pathname;
  let from = '';
  try {
    const ref = document.referrer ? new URL(document.referrer) : null;
    if (ref && ref.origin === location.origin && ref.pathname !== here) from = ref.pathname;
  } catch {
    /* referrer no válido */
  }
  document
    .querySelectorAll<HTMLInputElement>('[data-form-meta="pagina"]')
    .forEach((i) => (i.value = here));
  document
    .querySelectorAll<HTMLInputElement>('[data-form-meta="llegada"]')
    .forEach((i) => (i.value = from || new URLSearchParams(location.search).get('desde') || ''));
</script>
