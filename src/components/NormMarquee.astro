---
/**
 * Cinta de normativa: las normas pasan despacio de lado a lado y se paran al pasar el ratón.
 * Solo CSS. Con «reducir movimiento» queda fija. La lista se repite para que el bucle no se note
 * (la copia está oculta para lectores de pantalla).
 */
const norms = [
  'RD 487/2022',
  'RD 614/2024',
  'RD 3/2023',
  'RD 742/2013',
  'Decreto 99/2024',
  'ISO 11731',
  'ISO 6222',
  'ISO/TS 12869',
];
---

<section class="marquee" aria-label="Normativa que cubrimos">
  <div class="marquee__track">
    <ul class="marquee__row">
      {norms.map((n) => (
        <li>{n}</li>
      ))}
    </ul>
    <ul class="marquee__row" aria-hidden="true">
      {norms.map((n) => (
        <li>{n}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    padding-block: 1.1rem;
    border-block: 1px solid var(--color-border);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__row {
    display: flex;
    flex-shrink: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .marquee__row li {
    display: flex;
    align-items: center;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 300;
    white-space: nowrap;
    color: var(--color-text);
  }
  .marquee__row li::after {
    content: '';
    width: 6px;
    height: 6px;
    margin-inline: 2.2rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
    .marquee__row[aria-hidden='true'] {
      display: none;
    }
    .marquee__row {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 0.5rem;
    }
  }
</style>
