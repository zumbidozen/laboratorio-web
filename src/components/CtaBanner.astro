---
import { primaryCta, site } from '@/config/site';
import Icon from '@/components/Icon.astro';
export interface Props {
  title?: string;
  text?: string;
}
const {
  title = '¿Mueves muestras cada mes?',
  text = 'Cuéntanos cuántas y de qué tipo. Te preparamos una tarifa profesional con descuento por volumen y una prueba de dos meses con muestras duplicadas.',
} = Astro.props;
---

<section class="cta">
  <div class="container">
    <div class="cta__box reveal">
      <div class="cta__copy">
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--light" href={primaryCta.href}>
          {primaryCta.label}
          <Icon name="arrow-right" />
        </a>
        {site.contact.email && (
          <a class="cta__mail" href={`mailto:${site.contact.email}`}>
            <Icon name="mail" /> {site.contact.email}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-6);
  }
  .cta__box {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: var(--space-4);
    align-items: center;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(60rem 30rem at 110% -20%, rgb(20 184 166 / 0.35), transparent 60%),
      radial-gradient(40rem 20rem at -10% 120%, rgb(56 189 216 / 0.25), transparent 60%),
      var(--color-ink-2);
    color: var(--color-on-ink);
  }
  @media (min-width: 860px) {
    .cta__box {
      grid-template-columns: 1.6fr 1fr;
    }
    .cta__actions {
      justify-items: end;
    }
  }
  .cta h2 {
    color: #fff;
  }
  .cta p {
    margin-top: var(--space-3);
    color: var(--color-on-ink-muted);
    max-width: 38rem;
  }
  .cta__actions {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .cta__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-on-ink);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .cta__mail :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
