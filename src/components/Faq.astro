---
/**
 * Preguntas frecuentes accesibles (<details>), visibles para buscadores.
 * El JSON-LD FAQPage lo añade la página que lo usa (faqPage() en lib/schema).
 */
import Icon from '@/components/Icon.astro';
export interface Props {
  items: { q: string; a: string }[];
  title?: string;
  /** Muestra el título a la izquierda y las preguntas a la derecha. */
  split?: boolean;
}
const { items, title = 'Preguntas frecuentes', split = false } = Astro.props;
const id =
  'faq-' +
  title
    .toLowerCase()
    .normalize('NFD')
    .replace(/[^a-z0-9]+/g, '-');
---

{items.length > 0 && (
  <section class:list={['faq', { 'faq--split': split }]} aria-labelledby={id}>
    <div class="faq__head">
      <h2 id={id}>{title}</h2>
      <slot />
    </div>
    <div class="faq__list">
      {items.map(({ q, a }) => (
        <details>
          <summary>
            <span>{q}</span>
            <Icon name="plus" />
          </summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .faq {
    display: grid;
    gap: var(--space-4);
  }
  .faq:not(.faq--split) {
    max-width: var(--container-text);
  }
  @media (min-width: 900px) {
    .faq--split {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--space-6);
    }
  }
  .faq__head > :global(* + *) {
    margin-top: var(--space-3);
  }
  details {
    border-bottom: 1px solid var(--color-border);
  }
  details:first-child {
    border-top: 1px solid var(--color-border);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding-block: 1.15rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(svg) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-brand);
    transition: transform 0.25s var(--ease);
  }
  details[open] summary :global(svg) {
    transform: rotate(45deg);
  }
  details p {
    padding-bottom: 1.2rem;
    color: var(--color-text-muted);
    max-width: 42rem;
  }
</style>
