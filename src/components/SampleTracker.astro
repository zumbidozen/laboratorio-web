---
/**
 * «Una muestra, de principio a fin»: una muestra de ejemplo avanza sola por sus estados
 * (recibida → incubando → lectura → informe listo). Solo se anima mientras está en pantalla.
 * Con «reducir movimiento» no avanza sola: se muestra un botón «Siguiente».
 */
import Icon from '@/components/Icon.astro';

const states = [
  { s: 'recibida', label: 'Recibida en el laboratorio', pct: 8 },
  { s: 'incubando', label: 'Incubando · día 3 de 10', pct: 35 },
  { s: 'incubando', label: 'Incubando · día 8 de 10', pct: 70 },
  { s: 'lectura', label: 'Lectura y validación', pct: 88 },
  { s: 'listo', label: 'Informe listo · con tu logotipo', pct: 100 },
];
const steps = ['Recibida', 'Incubando', 'Lectura', 'Informe'];
---

<figure class="tracker" data-tracker>
  <script type="application/json" data-states set:html={JSON.stringify(states)} />
  <div class="tracker__card">
    <div class="tracker__top">
      <div>
        <p class="tracker__id">LG-2038 · Legionella</p>
        <p class="tracker__where">Residencia · ACS retorno</p>
      </div>
      <span class="tracker__chip" data-chip data-s="recibida">
        {states[0].label}
      </span>
    </div>
    <div class="tracker__bar">
      <span data-bar style={`width:${states[0].pct}%`}></span>
    </div>
    <ol class="tracker__steps" data-steps>
      {steps.map((s, i) => (
        <li class:list={{ on: i === 0 }}>{s}</li>
      ))}
    </ol>
    <p class="tracker__note" data-note>
      <Icon name="bell" />
      <span>Si el resultado sale fuera de límite, te avisamos en ese momento.</span>
    </p>
  </div>
  <figcaption>
    <span>Ejemplo ilustrativo del seguimiento en el portal.</span>
    <button type="button" class="tracker__btn" data-toggle aria-pressed="true">
      Pausar
    </button>
  </figcaption>
</figure>

<style>
  .tracker {
    margin: 0;
    display: grid;
    gap: 0.7rem;
    max-width: 30rem;
    width: 100%;
  }
  .tracker__card {
    display: grid;
    gap: 0.9rem;
    padding: 1.4rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    box-shadow: var(--shadow-lg);
  }
  .tracker__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .tracker__id {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .tracker__where {
    font-weight: 500;
  }
  .tracker__chip {
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    transition:
      background 0.4s,
      color 0.4s;
  }
  .tracker__chip[data-s='incubando'],
  .tracker__chip[data-s='listo'] {
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
  .tracker__chip[data-s='lectura'] {
    background: var(--color-warn-soft);
    color: var(--color-warn);
  }
  .tracker__bar {
    height: 6px;
    border-radius: 6px;
    background: var(--color-border);
    overflow: hidden;
  }
  .tracker__bar span {
    display: block;
    height: 100%;
    background: var(--color-accent);
    transition: width 0.8s var(--ease);
  }
  .tracker__steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .tracker__steps li {
    padding-top: 0.45rem;
    border-top: 2px solid var(--color-border);
    transition:
      border-color 0.4s,
      color 0.4s;
  }
  .tracker__steps li.on {
    border-color: var(--color-accent);
    color: var(--color-text);
  }
  .tracker__note {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
  .tracker__note :global(svg) {
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--color-accent-strong);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .tracker__btn {
    font: inherit;
    font-size: 0.8rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) {
    .tracker__bar span,
    .tracker__chip,
    .tracker__steps li {
      transition: none;
    }
  }
</style>

<script>
  type State = { s: string; label: string; pct: number };
  const stepOf: Record<string, number> = { recibida: 0, incubando: 1, lectura: 2, listo: 3 };
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-tracker]').forEach((root) => {
    const states = JSON.parse(root.querySelector('[data-states]')!.textContent!) as State[];
    const chip = root.querySelector<HTMLElement>('[data-chip]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-steps] li')];
    const btn = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    let i = 0;
    let timer: number | undefined;
    let visible = false;
    let paused = false;

    const paint = () => {
      const st = states[i];
      chip.dataset.s = st.s;
      chip.textContent = st.label;
      bar.style.width = `${st.pct}%`;
      steps.forEach((el, k) => el.classList.toggle('on', k <= stepOf[st.s]));
    };
    const next = () => {
      i = (i + 1) % states.length;
      paint();
    };
    const sync = () => {
      window.clearInterval(timer);
      if (visible && !paused && !reduce) timer = window.setInterval(next, 1600);
    };

    if (reduce) {
      btn.textContent = 'Siguiente estado';
      btn.removeAttribute('aria-pressed');
      btn.addEventListener('click', next);
      return;
    }
    btn.addEventListener('click', () => {
      paused = !paused;
      btn.textContent = paused ? 'Reanudar' : 'Pausar';
      btn.setAttribute('aria-pressed', String(!paused));
      sync();
    });
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      sync();
    }).observe(root);
  });
</script>
