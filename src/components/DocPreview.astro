---
/**
 * Vista previa del PDF de un recurso: páginas apiladas como un documento real.
 * Las imágenes (`src/assets/recursos/<id>-1.png`…) las genera `npm run descargables`
 * a partir del propio documento.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { recursoPorId } from '@/data/recursos';

export interface Props {
  /** Id del recurso de `src/data/recursos.ts` (por defecto, la checklist). */
  recurso?: string;
  /** Tamaño: 'md' para el bloque de las guías, 'lg' para la página del recurso. */
  size?: 'md' | 'lg';
}
const { recurso, size = 'md' } = Astro.props;
const r = recursoPorId(recurso);
const todas = import.meta.glob<{ default: ImageMetadata }>('../assets/recursos/*.png', {
  eager: true,
});
const pagina = (n: number) => todas[`../assets/recursos/${r.id}-${n}.png`]?.default;
const p1 = pagina(1);
const p2 = pagina(2);
const p3 = pagina(3);
// Un recurso nuevo no tiene vista previa hasta que se ejecuta `npm run descargables`.
if (!p1) console.warn(`Falta la vista previa de «${r.id}»: ejecuta npm run descargables`);
const widths = size === 'lg' ? [280, 420, 560] : [220, 330, 440];
const sizes = size === 'lg' ? '(min-width: 900px) 360px, 70vw' : '(min-width: 900px) 260px, 60vw';
---

{p1 && (
  <figure class:list={['preview', `preview--${size}`]}>
    <div class="preview__stack" aria-hidden="true">
      {p3 && (
        <div class="sheet sheet--back">
          <Image src={p3} alt="" widths={widths} sizes={sizes} loading="lazy" />
        </div>
      )}
      {p2 && (
        <div class="sheet sheet--mid">
          <Image src={p2} alt="" widths={widths} sizes={sizes} loading="lazy" />
        </div>
      )}
      <div class="sheet sheet--front">
        <Image
          src={p1}
          alt={`Portada del PDF: ${r.title}`}
          widths={widths}
          sizes={sizes}
          loading="lazy"
        />
      </div>
      <span class="preview__badge">PDF · {r.pages} páginas</span>
    </div>
    <figcaption class="visually-hidden">Vista previa del PDF. {r.pitch}</figcaption>
  </figure>
)}

<style>
  .preview {
    margin: 0;
    display: grid;
    place-items: center;
  }
  .preview__stack {
    position: relative;
    width: 13.5rem;
    max-width: calc(100vw - 7rem);
    aspect-ratio: 1 / 1.414;
    margin: 1.2rem 2.2rem 1.6rem 1.2rem;
  }
  .preview--lg .preview__stack {
    width: 19rem;
  }
  .sheet {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 6px;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(11 60 93 / 0.08),
      0 18px 40px -16px rgb(11 60 93 / 0.35);
    transition: transform 0.4s var(--ease);
  }
  .sheet :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .sheet--back {
    transform: translate(1.6rem, -0.6rem) rotate(7deg);
  }
  .sheet--mid {
    transform: translate(0.8rem, -0.3rem) rotate(3.5deg);
  }
  .preview:hover .sheet--back {
    transform: translate(2.2rem, -0.8rem) rotate(10deg);
  }
  .preview:hover .sheet--mid {
    transform: translate(1.1rem, -0.4rem) rotate(5deg);
  }
  .preview:hover .sheet--front {
    transform: translateY(-4px);
  }
  .preview__badge {
    position: absolute;
    left: -0.6rem;
    bottom: 1.2rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--color-petrol);
    color: #fff;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    box-shadow: var(--shadow);
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transition: none;
    }
  }
</style>
