---
/**
 * Barra de lectura: una línea turquesa bajo la cabecera muestra cuánto queda del artículo.
 * Mide el elemento indicado con `target` (selector CSS).
 */
export interface Props {
  target: string;
}
const { target } = Astro.props;
---

<div class="reading" data-reading={target} aria-hidden="true">
  <span></span>
</div>

<style>
  .reading {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 3px;
    pointer-events: none;
  }
  .reading span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(0);
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading]');
  const article = bar ? document.querySelector<HTMLElement>(bar.dataset.reading!) : null;
  const fill = bar?.querySelector<HTMLElement>('span');
  if (bar && article && fill) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = article.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.6;
      const done = Math.min(1, Math.max(0, -r.top / Math.max(1, total)));
      fill.style.transform = `scaleX(${done})`;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
