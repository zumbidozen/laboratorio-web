---
/**
 * Bloque de descarga de un recurso (PDF a cambio del email).
 * Se usa en las guías, el glosario, el calendario, la calculadora y /recursos/.
 * Sin `recurso`, ofrece la checklist de Legionella.
 */
import WebForm from '@/components/WebForm.astro';
import Icon from '@/components/Icon.astro';
import DocPreview from '@/components/DocPreview.astro';
import { recursoPorId } from '@/data/recursos';

export interface Props {
  /** Id del recurso de `src/data/recursos.ts`. */
  recurso?: string;
  /** Dónde se muestra (se guarda con el envío para saber qué página convierte). */
  origin: string;
  /** Vista previa más grande (página del recurso). */
  large?: boolean;
}
const { recurso, origin, large = false } = Astro.props;
const r = recursoPorId(recurso);
const headingId = `magnet-${r.id}-${origin}`;
---

<aside
  data-pagefind-ignore
  class:list={['magnet', { 'magnet--large': large }]}
  aria-labelledby={headingId}
>
  <div class="magnet__visual">
    <DocPreview recurso={r.id} size={large ? 'lg' : 'md'} />
  </div>
  <div class="magnet__copy">
    <p class="eyebrow">Descarga gratuita · PDF</p>
    <h2 id={headingId}>{r.title}</h2>
    <p>{r.pitch}</p>
    <ul class="checklist">
      {r.bullets.map((b) => (
        <li>
          <Icon name="check" />
          <span>{b}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="magnet__form">
    <WebForm name={r.formName} submit={r.submit} success={r.thanks} mailSubject={r.title} compact>
      <input type="hidden" name="origen" value={origin} />
      <label class="field">
        <span>Email profesional</span>
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label class="field">
        <span>Empresa</span>
        <input name="empresa" autocomplete="organization" />
      </label>
      <label class="field">
        <span>Tú eres…</span>
        <select name="perfil">
          <option>Empresa de mantenimiento o de control de Legionella</option>
          <option>Responsable de un edificio o instalación</option>
          <option>Gestor de piscinas</option>
          <option>Administrador de fincas o comunidad de propietarios</option>
          <option>Otro</option>
        </select>
      </label>
    </WebForm>
  </div>
</aside>

<style>
  .magnet {
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(40rem 20rem at 100% 0%, var(--color-accent-soft), transparent 70%),
      var(--color-brand-tint);
    border: 1px solid var(--color-border);
  }
  @media (min-width: 720px) {
    .magnet {
      grid-template-columns: auto 1fr;
      align-items: center;
    }
    .magnet__form {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1100px) {
    .magnet {
      grid-template-columns: auto 1.15fr 1fr;
      gap: var(--space-5);
    }
    .magnet__form {
      grid-column: auto;
    }
  }
  .magnet__visual {
    display: grid;
    place-items: center;
  }
  .magnet h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    margin-top: 0.4rem;
  }
  .magnet__copy > p:not(.eyebrow) {
    margin-top: 0.6rem;
    color: var(--color-text-muted);
  }
  .magnet .checklist {
    margin-top: var(--space-3);
  }
  .magnet__form {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    box-shadow: var(--shadow);
  }
</style>
