---
import { site, mainNav, primaryCta } from '@/config/site';
import Logo from '@/components/Logo.astro';
import Icon from '@/components/Icon.astro';
const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(href);
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="header__brand" href="/" aria-label={`${site.name}, inicio`}>
      <Logo />
    </a>
    <button
      class="header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-toggle
    >
      <span class="visually-hidden">Menú</span>
      <span class="header__bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
    <nav id="menu-principal" class="header__nav" aria-label="Principal">
      <ul>
        {mainNav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        class="header__search"
        href="/buscar/"
        aria-current={current.startsWith('/buscar') ? 'page' : undefined}
      >
        <Icon name="search" />
        <span class="header__search-label">Buscar</span>
      </a>
      {site.contact.phone && (
        <a class="header__phone" href={`tel:${site.contact.phone}`}>
          <Icon name="phone" />
          {site.contact.phoneDisplay || site.contact.phone}
        </a>
      )}
      <a class="btn header__cta" href={primaryCta.href}>
        {primaryCta.label}
        <Icon name="arrow-right" />
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    view-transition-name: site-header;
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-brand-tint) 80%, transparent);
    backdrop-filter: saturate(1.6) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .header[data-scrolled] {
    border-bottom-color: var(--color-border);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4.5rem;
    transition: min-height 0.25s var(--ease);
  }
  .header[data-scrolled] .header__inner {
    min-height: 3.6rem;
  }
  .header :global(.logo) {
    transition:
      height 0.25s var(--ease),
      width 0.25s var(--ease);
  }
  .header[data-scrolled] :global(.logo) {
    height: 22px;
    width: 115px;
  }
  .header[data-scrolled] {
    box-shadow: 0 8px 20px -16px rgb(11 60 93 / 0.35);
  }
  @media (prefers-reduced-motion: reduce) {
    .header__inner,
    .header :global(.logo) {
      transition: none;
    }
  }
  .header__brand {
    text-decoration: none;
  }
  .header__toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
  }
  .header__bars {
    display: grid;
    gap: 4px;
  }
  .header__bars span {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.2s var(--ease),
      opacity 0.2s;
  }
  [aria-expanded='true'] .header__bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  [aria-expanded='true'] .header__bars span:nth-child(2) {
    opacity: 0;
  }
  [aria-expanded='true'] .header__bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  .header__nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: var(--space-3) 1.25rem var(--space-4);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
  }
  .header__nav[data-open] {
    display: grid;
    gap: var(--space-3);
  }
  .header__nav ul {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .header__nav a:not(.btn) {
    display: block;
    padding: 0.7rem 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }
  .header__nav a[aria-current='page'] {
    color: var(--color-brand);
  }

  .header__search {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
  }
  .header__search :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  .header__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }
  .header__phone :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--color-accent-strong);
  }
  @media (min-width: 1120px) {
    .header__toggle {
      display: none;
    }
    .header__search {
      display: grid;
      place-items: center;
      width: 2.4rem;
      height: 2.4rem;
      border-radius: 999px;
      color: var(--color-text-muted);
    }
    .header__search:hover,
    .header__search[aria-current='page'] {
      background: var(--color-surface);
      color: var(--color-text);
    }
    .header__search-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .header__nav {
      display: flex;
      align-items: center;
      gap: var(--space-5);
      position: static;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
    }
    .header__nav ul {
      display: flex;
      gap: var(--space-1);
    }
    .header__nav a:not(.btn) {
      padding: 0.45rem 0.8rem;
      border: 0;
      border-radius: 999px;
      font-size: 0.95rem;
      color: var(--color-text-muted);
    }
    .header__nav a:not(.btn):hover,
    .header__nav a[aria-current='page'] {
      color: var(--color-text);
      background: var(--color-surface);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-toggle]');
  const nav = document.getElementById('menu-principal');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    nav?.toggleAttribute('data-open', open);
  });
  // Con margen (40 px para compactar, 8 px para volver) para que no parpadee.
  const onScroll = () => {
    const y = window.scrollY;
    if (y > 40) header?.setAttribute('data-scrolled', '');
    else if (y < 8) header?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
