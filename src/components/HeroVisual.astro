---
/**
 * Ilustración de la portada: el tubo de ensayo de la marca (la «u» de Ensayum)
 * en cristal, con la muestra en turquesa y la colonia en coral, y tarjetas
 * flotantes con compromisos reales. Todo SVG y CSS: sin imágenes que cargar.
 */
import Icon from '@/components/Icon.astro';
---

<div class="visual" aria-hidden="true">
  <div class="visual__orb visual__orb--a"></div>
  <div class="visual__orb visual__orb--b"></div>

  <svg class="visual__tube" viewBox="0 0 360 620" fill="none">
    <defs>
      <linearGradient id="glass" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#ffffff" stop-opacity="0.55"></stop>
        <stop offset="0.18" stop-color="#ffffff" stop-opacity="0.12"></stop>
        <stop offset="0.75" stop-color="#ffffff" stop-opacity="0.06"></stop>
        <stop offset="1" stop-color="#ffffff" stop-opacity="0.45"></stop>
      </linearGradient>
      <linearGradient id="liquid" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#5fd3c8"></stop>
        <stop offset="0.55" stop-color="#1fb5a8"></stop>
        <stop offset="1" stop-color="#0f8e84"></stop>
      </linearGradient>
      <linearGradient id="liquidShade" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#0b3c5d" stop-opacity="0.18"></stop>
        <stop offset="0.35" stop-color="#ffffff" stop-opacity="0.15"></stop>
        <stop offset="1" stop-color="#0b3c5d" stop-opacity="0.28"></stop>
      </linearGradient>
      <radialGradient id="colony" cx="0.4" cy="0.35" r="0.7">
        <stop offset="0" stop-color="#ff9d92"></stop>
        <stop offset="1" stop-color="#ff6b5b"></stop>
      </radialGradient>
      <clipPath id="tubeInside">
        <path d="M110 60V448A70 70 0 0 0 250 448V60Z"></path>
      </clipPath>
      <filter id="soft" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="14"></feGaussianBlur>
      </filter>
    </defs>

    <!-- sombra -->
    <ellipse
      cx="190"
      cy="592"
      rx="110"
      ry="14"
      fill="#0b3c5d"
      opacity="0.18"
      filter="url(#soft)"
    ></ellipse>

    <g transform="rotate(-8 180 320)">
      <!-- líquido -->
      <g clip-path="url(#tubeInside)">
        <rect x="100" y="300" width="160" height="240" fill="url(#liquid)"></rect>
        <rect x="100" y="300" width="160" height="240" fill="url(#liquidShade)"></rect>
        <ellipse cx="180" cy="300" rx="70" ry="10" fill="#9be7df" opacity="0.9"></ellipse>
        <circle class="bubble b1" cx="150" cy="470" r="5" fill="#fff" opacity="0.55"></circle>
        <circle class="bubble b2" cx="205" cy="430" r="3.5" fill="#fff" opacity="0.5"></circle>
        <circle class="bubble b3" cx="168" cy="400" r="2.5" fill="#fff" opacity="0.6"></circle>
        <circle class="bubble b4" cx="222" cy="490" r="4" fill="#fff" opacity="0.45"></circle>
        <!-- colonia detectada -->
        <circle cx="182" cy="455" r="17" fill="url(#colony)"></circle>
        <circle cx="176" cy="449" r="5" fill="#fff" opacity="0.35"></circle>
      </g>

      <!-- cristal -->
      <path
        d="M110 60V448A70 70 0 0 0 250 448V60"
        fill="url(#glass)"
        stroke="#ffffff"
        stroke-opacity="0.9"
        stroke-width="3"
      ></path>
      <path
        d="M110 60V448A70 70 0 0 0 250 448V60"
        stroke="#0b3c5d"
        stroke-opacity="0.22"
        stroke-width="1.5"
      ></path>
      <!-- reflejos -->
      <path
        d="M124 90V430"
        stroke="#fff"
        stroke-opacity="0.85"
        stroke-width="6"
        stroke-linecap="round"
      ></path>
      <path
        d="M236 110V300"
        stroke="#fff"
        stroke-opacity="0.35"
        stroke-width="3"
        stroke-linecap="round"
      ></path>
      <!-- boca -->
      <ellipse
        cx="180"
        cy="60"
        rx="80"
        ry="14"
        fill="#ffffff"
        fill-opacity="0.35"
        stroke="#ffffff"
        stroke-width="3"
      ></ellipse>
      <ellipse cx="180" cy="60" rx="80" ry="14" stroke="#0b3c5d" stroke-opacity="0.2"></ellipse>
      <!-- graduación -->
      <g stroke="#0b3c5d" stroke-opacity="0.25" stroke-width="1.5">
        <path d="M218 160h22M226 200h14M218 240h22M226 280h14M218 320h22M226 360h14"></path>
      </g>
    </g>
  </svg>

  <div class="float float--alert">
    <span class="float__icon float__icon--alert">
      <Icon name="bell" />
    </span>
    <div>
      <p class="float__title">Aviso inmediato</p>
      <p class="float__text">
        Torre 2 · fuera de límite
        <br />
        Llamada al responsable · 9:14
      </p>
    </div>
  </div>

  <div class="float float--ring">
    <p class="float__kicker">Legionella · ACS</p>
    <div class="ring">
      <svg viewBox="0 0 80 80">
        <circle
          cx="40"
          cy="40"
          r="32"
          stroke="var(--color-brand-soft)"
          stroke-width="7"
          fill="none"
        ></circle>
        <circle
          cx="40"
          cy="40"
          r="32"
          stroke="var(--color-accent)"
          stroke-width="7"
          fill="none"
          stroke-linecap="round"
          stroke-dasharray="120.6 201"
          transform="rotate(-90 40 40)"
        ></circle>
      </svg>
      <span>6/10</span>
    </div>
    <p class="float__text">
      días de incubación
      <br />
      <strong>Plazo máximo: 10 días</strong>
    </p>
  </div>

  <div class="float float--report">
    <span class="float__icon">
      <Icon name="file" />
    </span>
    <div>
      <p class="float__title">Informe con tu logotipo</p>
      <p class="float__text">Listo para el titular</p>
    </div>
  </div>
</div>

<style>
  .visual {
    position: relative;
    min-height: 34rem;
    display: grid;
    place-items: center;
  }
  .visual__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(10px);
  }
  .visual__orb--a {
    width: 26rem;
    height: 26rem;
    background: radial-gradient(circle at 35% 35%, #d9f4f1, #bfe9e4 45%, transparent 70%);
    top: 8%;
    left: 12%;
  }
  .visual__orb--b {
    width: 16rem;
    height: 16rem;
    background: radial-gradient(circle at 50% 50%, #dbe7f0, transparent 70%);
    bottom: 4%;
    right: 2%;
  }
  .visual__tube {
    position: relative;
    width: min(18rem, 62%);
    height: auto;
    filter: drop-shadow(0 30px 40px rgb(11 60 93 / 0.12));
  }

  .float {
    position: absolute;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.95rem 1.1rem;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.72);
    border: 1px solid rgb(255 255 255 / 0.9);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 20px 40px -18px rgb(11 60 93 / 0.28);
    color: var(--color-petrol);
  }
  .float--alert {
    top: 10%;
    right: 0;
    max-width: 16rem;
  }
  .float--ring {
    flex-direction: column;
    align-items: center;
    text-align: center;
    bottom: 12%;
    right: 2%;
    width: 11.5rem;
  }
  .float--report {
    left: 0;
    bottom: 22%;
  }
  .float__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 10px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
  .float__icon--alert {
    background: #fbe6e4;
    color: #c0362c;
  }
  .float__icon :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .float__title {
    font-weight: 500;
    font-size: 0.92rem;
    line-height: 1.3;
  }
  .float__text {
    font-size: 0.8rem;
    line-height: 1.4;
    color: #4a5e6d;
  }
  .float__text strong {
    font-weight: 500;
    color: var(--color-petrol);
  }
  .float__kicker {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #4a5e6d;
  }
  .ring {
    position: relative;
    width: 5rem;
    height: 5rem;
    margin-block: 0.4rem;
  }
  .ring svg {
    width: 100%;
    height: 100%;
  }
  .ring span {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 1.35rem;
    font-weight: 300;
  }

  @media (max-width: 640px) {
    .visual {
      min-height: 25rem;
      justify-items: start;
    }
    .visual__tube {
      width: 46%;
      margin-left: 6%;
    }
    .float--report {
      display: none;
    }
    .float--alert {
      top: 4%;
      right: 0;
      max-width: 12.5rem;
      padding: 0.75rem 0.85rem;
    }
    .float--ring {
      width: 9.5rem;
      bottom: 6%;
      right: 0;
      padding: 0.85rem;
    }
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .float {
      background: rgb(7 42 66 / 0.72);
      border-color: rgb(255 255 255 / 0.12);
      color: #fff;
    }
    :global(:root:not([data-theme='light'])) .float__text,
    :global(:root:not([data-theme='light'])) .float__kicker {
      color: #b9cddb;
    }
    :global(:root:not([data-theme='light'])) .float__text strong {
      color: #fff;
    }
    :global(:root:not([data-theme='light'])) .visual__orb--a {
      background: radial-gradient(circle at 35% 35%, #11546a, #0c4257 45%, transparent 70%);
    }
    :global(:root:not([data-theme='light'])) .visual__orb--b {
      background: radial-gradient(circle at 50% 50%, #0f3d5c, transparent 70%);
    }
  }

  :global(:root[data-theme='dark']) .float {
    background: rgb(7 42 66 / 0.72);
    border-color: rgb(255 255 255 / 0.12);
    color: #fff;
  }
  :global(:root[data-theme='dark']) .float__text,
  :global(:root[data-theme='dark']) .float__kicker {
    color: #b9cddb;
  }
  :global(:root[data-theme='dark']) .float__text strong {
    color: #fff;
  }
  :global(:root[data-theme='dark']) .visual__orb--a {
    background: radial-gradient(circle at 35% 35%, #11546a, #0c4257 45%, transparent 70%);
  }
  :global(:root[data-theme='dark']) .visual__orb--b {
    background: radial-gradient(circle at 50% 50%, #0f3d5c, transparent 70%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bubble {
      animation: rise 5s ease-in infinite;
    }
    .b2 {
      animation-delay: 1.2s;
    }
    .b3 {
      animation-delay: 2.4s;
    }
    .b4 {
      animation-delay: 3.3s;
    }
    @keyframes rise {
      0% {
        transform: translateY(0);
        opacity: 0;
      }
      15% {
        opacity: 0.6;
      }
      100% {
        transform: translateY(-150px);
        opacity: 0;
      }
    }
    .float {
      animation: float-in 0.8s var(--ease) both;
    }
    .float--ring {
      animation-delay: 0.25s;
    }
    .float--report {
      animation-delay: 0.45s;
    }
    @keyframes float-in {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
    }
  }
</style>
