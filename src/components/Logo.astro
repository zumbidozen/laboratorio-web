---
/** Logotipo provisional: gota + placa de cultivo. Cambia el SVG cuando haya logo definitivo. */
import { site } from '@/config/site';
export interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;
---

<span class:list={['logo', { 'logo--inverted': inverted }]}>
  <svg viewBox="0 0 40 40" aria-hidden="true" width="34" height="34">
    <rect width="40" height="40" rx="11" class="logo__bg"></rect>
    <path d="M20 7.5c-4.6 5.8-9 11-9 16a9 9 0 0 0 18 0c0-5-4.4-10.2-9-16z" fill="#fff"></path>
    <circle cx="17" cy="25" r="2.1" class="logo__dot"></circle>
    <circle cx="22.6" cy="28.6" r="1.4" class="logo__dot"></circle>
    <circle cx="22.4" cy="22.4" r="1.1" class="logo__dot"></circle>
  </svg>
  <span class="logo__text">{site.shortName}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .logo__bg {
    fill: #0e7490;
  }
  .logo__dot {
    fill: var(--color-accent);
  }
  .logo--inverted {
    color: #fff;
  }
</style>
