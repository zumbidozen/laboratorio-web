{
  "name": "laboratorio-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:seo": "node scripts/check-seo.mjs",
    "verify": "npm run check && npm run build && npm run check:seo && npm run format:check",
    "og": "node scripts/og-image.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jost": "^5.3.0",
    "astro": "^7.4.5",
    "lucide-static": "^1.69.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "description": "Web del laboratorio de análisis de aguas (Madrid). Astro, SEO e IA friendly.",
  "engines": {
    "node": ">=22"
  }
}
